# Copy to .env (never commit .env). Everything except DATABASE_URL is optional:
# with no LLM keys Keel runs on its deterministic offline rules.
DATABASE_URL=postgresql+psycopg://keel:keel@localhost:5433/keel
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3200

GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=

ROUTER_GGUF_PATH=
ROUTER_MIN_CONFIDENCE=0.6

JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ADMIN_EMAIL=admin@keel.demo
ADMIN_PASSWORD=KeelAdmin!2026
AGENT_EMAIL=agent@keel.demo
AGENT_PASSWORD=KeelAgent!2026

REFUND_AUTO_LIMIT_GBP=50
AUTO_SEND_CONFIDENCE=0.7

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-random-path-segment
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Hearth & Field Support <support@yourdomain.com>
REPORT_TO=
REPORT_HOUR_UTC=8
SLACK_WEBHOOK_URL=
N8N_HMAC_SECRET=change-me
