{
  "name": "Keel \u00b7 Daily management report",
  "nodes": [
    {
      "id": "7313cf49-2113-51ce-bb04-a22c89af1002",
      "name": "Every day 08:00 UK",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "c9862393-5336-5ef8-b162-573dfed3323d",
      "name": "Request report data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: { payload: { action: 'report_data' } } }];"
      }
    },
    {
      "id": "64203993-0b87-5795-a8c9-26335f60eecd",
      "name": "Sign (HMAC-SHA256)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.KEEL_N8N_HMAC_SECRET;\nconst ts = Math.floor(Date.now() / 1000).toString();\nreturn $input.all().map(item => {\n  const body = JSON.stringify(item.json.payload);\n  const sig = crypto.createHmac('sha256', secret).update(ts + '.' + body).digest('hex');\n  return { json: { body, signature: `t=${ts},v1=${sig}` } };\n});"
      }
    },
    {
      "id": "b6e1c91d-a8ef-5039-8318-5ce1ce4d29fe",
      "name": "Fetch report from Keel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.KEEL_API_URL}}/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-keel-signature",
              "value": "={{$json.signature}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{$json.body}}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "029597b4-2d00-54e2-9cac-cd0c8a07ff5a",
      "name": "Email management",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        960,
        -80
      ],
      "parameters": {
        "fromEmail": "={{$env.KEEL_REPORT_FROM}}",
        "toEmail": "={{$env.KEEL_REPORT_TO}}",
        "subject": "Daily AI operations report \u00b7 Hearth & Field",
        "emailFormat": "html",
        "html": "={{$json.html}}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "",
          "name": "Report SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "id": "eed14932-1c28-58a4-b043-d6aee7630303",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.KEEL_SLACK_WEBHOOK}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ':bar_chart: ' + $json.text }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3
    }
  ],
  "connections": {
    "Every day 08:00 UK": {
      "main": [
        [
          {
            "node": "Request report data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request report data": {
      "main": [
        [
          {
            "node": "Sign (HMAC-SHA256)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign (HMAC-SHA256)": {
      "main": [
        [
          {
            "node": "Fetch report from Keel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch report from Keel": {
      "main": [
        [
          {
            "node": "Email management",
            "type": "main",
            "index": 0
          },
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "keel-error-handler"
  },
  "active": false,
  "meta": {
    "templateCredsSetupCompleted": false
  }
}